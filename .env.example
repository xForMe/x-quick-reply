# 生成模型：填写 OpenAI 兼容 Base URL（包含版本路径，不含 /chat/completions）。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 仅当生成服务支持 response_format=json_object 时启用。
LLM_JSON_MODE=false

# 百炼普通 API：填写完整 System One 地址和密钥。
# 地址格式：https://<业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone
DECISION_PROVIDER=bailian
BAILIAN_SYSTEMONE_URL=
DASHSCOPE_API_KEY=
# 若使用 Token Plan，将 DECISION_PROVIDER 改为 bailian-token-plan，填写专用密钥。
# Token Plan 的官方网关地址由程序固定，不读取普通 API 的地址和密钥。
BAILIAN_TOKEN_PLAN_API_KEY=
MODEL_TIMEOUT_SECONDS=25
QUICK_REPLY_PORT=8787
